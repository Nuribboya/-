# --- Minecraft server (Java Edition) ---
MC_HOST=localhost
MC_PORT=25565
MC_USER=ClaudeBot
# MC_VERSION=1.20.4   # 비워두면 자동 감지

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- 두뇌 선택 (anthropic | ollama) ---
# fast: 평소 판단(호출 많음) / smart: 새 스킬 코드 작성(호출 적음)
FAST_PROVIDER=anthropic
FAST_MODEL=claude-haiku-5-5
SMART_PROVIDER=anthropic
SMART_MODEL=claude-sonnet-5-5

# 무료 로컬 모드 예시:
# FAST_PROVIDER=ollama
# FAST_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434

# --- 안전장치 ---
DAILY_BUDGET_USD=15
DECISION_INTERVAL_MS=2000
