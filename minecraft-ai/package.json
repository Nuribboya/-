{
  "name": "minecraft-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft bot that plays and learns on its own. Brain is swappable: Claude API or local Ollama model.",
  "scripts": {
    "start": "node src/index.js",
    "start:free": "node --env-file=.env.free src/index.js",
    "report": "node --env-file-if-exists=.env.free src/report.js",
    "brain": "node --env-file-if-exists=.env.free src/brain-cli.js",
    "new-world": "node --env-file-if-exists=.env.free src/new-world.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "mineflayer": "^4.23.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.11.0"
  }
}
