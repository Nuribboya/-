# 공용 기본값 (업데이트로 바뀔 수 있음). 내 설정(포트, 봇 수 등)은 이 파일 말고 .env.local 에 적으세요.
# .env.local 에 적은 값이 여기 값보다 우선합니다.
# 무료 모드: API 키/비용 없음. 전부 로컬 Ollama 모델로 동작.
MC_HOST=localhost
MC_PORT=25565
MC_USER=FreeBot

FAST_PROVIDER=ollama
FAST_MODEL=qwen2.5:7b
SMART_PROVIDER=ollama
SMART_MODEL=qwen2.5-coder:7b

OLLAMA_URL=http://localhost:11434
OLLAMA_CTX=8192
# 로컬 모델은 느리므로 간격을 조금 늘려도 됨
DECISION_INTERVAL_MS=300
# 봇 여러 마리 (스킬·교훈 공유, 이름: MC_USER, MC_USER_2, ...)
BOT_COUNT=1
